# Gemini Configuration
GOOGLE_API_KEY=
GOOGLE_MODEL=

# Ollama Configuration
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# API Key (Next.js ↔ FastAPI 서비스 간 인증, 프로덕션에서는 반드시 변경)
API_KEY=

# Qdrant Configuration (로컬 직접 실행 시 localhost / 도커는 compose가 qdrant 로 주입)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 업로드 파일 저장 경로. UI(ui/.env*)의 UPLOAD_DIR 와 동일 경로로 맞춰야
# /index 호출 시 "허용되지 않은 file_path" 400 오류가 발생하지 않는다.
# 미설정 시 백엔드는 <repo>/data/uploads 를 기본 허용 경로로 사용한다.
UPLOAD_DIR=

# NextAuth 콜백 검증용 절대 URL (운영 도메인 사용 권장, 미설정 시 localhost:3000)
# 운영 배포 시 reverse proxy 의 공개 도메인을 https 로 지정한다.
#   예) AUTH_URL=https://rag.okdoitttt.com
AUTH_URL=

# === 배포(reverse proxy) 시 호스트 포트 바인딩 ===
# compose.yaml 이 아래 변수로 호스트 노출 포트를 결정한다(미설정 시 127.0.0.1 기본 포트).
# 같은 서버에 다른 프로젝트가 떠 있어 포트가 겹칠 때만 값을 채운다.
# nginx 는 UI_BIND 의 포트로 proxy_pass 한다. API/Qdrant 는 노출 불필요(내부망 통신).
#   예) UI_BIND=127.0.0.1:3001
#       API_BIND=127.0.0.1:8001
#       QDRANT_BIND=127.0.0.1:6335
#       QDRANT_GRPC_BIND=127.0.0.1:6336
UI_BIND=
API_BIND=
QDRANT_BIND=
QDRANT_GRPC_BIND=