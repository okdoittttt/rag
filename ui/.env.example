# UI(Next.js) 환경 변수 템플릿
# 로컬 개발: 이 파일을 복사해 ui/.env.local 을 만들고 값을 채운다.
#   cp ui/.env.example ui/.env.local
# 도커 실행: ui/.env 를 사용한다(컨테이너 내부 경로/호스트명 기준).
# Next.js 는 .env.local 을 .env 보다 우선 로드한다.

# Prisma DB 경로. 로컬은 SQLite이며 ui/prisma/schema.prisma 디렉터리 기준 상대경로.
# (도커는 /app/prisma/dev.db 처럼 절대경로 사용)
DATABASE_URL="file:./dev.db"

# NextAuth 세션 암호화 키. 아래 명령으로 생성: openssl rand -base64 32
AUTH_SECRET=

# FastAPI 백엔드 주소.
#   로컬 직접 실행: http://127.0.0.1:8000
#   도커 네트워크: http://api:8000
API_URL=http://127.0.0.1:8000

# 백엔드(FastAPI) 인증 키. 루트 .env 의 API_KEY 와 반드시 동일하게 유지한다.
# (빈 값이면 개발 환경 한정으로 백엔드 인증 미들웨어가 비활성화됨)
API_KEY=

# 업로드 파일 저장 경로. 백엔드의 허용 경로(<repo>/data/uploads)와 일치시켜야
# /index 호출 시 "허용되지 않은 file_path" 400 오류가 발생하지 않는다.
# UI를 ui/ 디렉터리에서 직접 실행할 때는 cwd 영향을 피하도록 절대경로를 권장한다.
#   예) UPLOAD_DIR=/absolute/path/to/rag/data/uploads
UPLOAD_DIR=
